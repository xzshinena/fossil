# ── Adzuna Jobs API ───────────────────────────────────────────────
# Required only for the jobs ingest source.
# Sign up at https://developer.adzuna.com → "Register for free access"
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Semantic Scholar ──────────────────────────────────────────────
# Optional. Without it, the citations sub-score is skipped (partial=True).
# Sign up at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Google Cloud Platform ─────────────────────────────────────────
# Required only for the GitHub Archive ingest (BigQuery).
# Place your service account JSON at data/gcp-credentials.json
# and set this to: data/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=